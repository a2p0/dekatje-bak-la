<div class="<%= card_classes %>">
  <% if header? %>
    <div class="px-5 py-4">
      <%= header %>
    </div>
  <% end %>

  <% if body? %>
    <div class="px-5 py-4">
      <%= body %>
    </div>
  <% end %>

  <% if footer? %>
    <div class="<%= footer_classes %>">
      <%= footer %>
    </div>
  <% end %>
</div>
